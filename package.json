{
  "name": "gro10x-os",
  "version": "2.1.0-hardened",
  "description": "GRO10X AI Growth Agency & Multi-Engine Operating System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:fast": "jest tests/engine1_bridge.test.js tests/commerce10x_bridge.test.js tests/toffeecon_bridge.test.js tests/purplebot_bridge.test.js tests/engine1_desk_integration.test.js tests/auth.test.js tests/system-health.test.js tests/rbac-engine-scoping.test.js tests/subphase_4_3_telemetry_bot_mesh.test.js --forceExit",
    "test:bridge": "jest tests/engine1_bridge.test.js tests/commerce10x_bridge.test.js tests/toffeecon_bridge.test.js tests/purplebot_bridge.test.js tests/engine1_desk_integration.test.js --forceExit",
    "test:bot": "jest tests/subphase_4_3_telemetry_bot_mesh.test.js tests/subphase_1_3_weekly_executive_cron.test.js tests/subphase_5_3_email_templates_and_crons.test.js --detectOpenHandles --forceExit",
    "test:e2e": "node scripts/e2e/runner.js",
    "test:e2e:client": "node scripts/e2e-client/runner.js",
    "test:e2e:prospect": "node scripts/e2e-prospect/runner.js",
    "clean:reports": "node scripts/clean-reports.js",
    "db:seed": "node scripts/seed-supabase.js",
    "db:prod-reset": "node scripts/prepare-production-db.js",
    "register-webhook": "node register-webhook.js",
    "export:planner:pla14": "node scripts/export-planner-pdf.js",
    "check:prod": "node scripts/check-production-readiness.js"
  },
  "keywords": [
    "gro10x",
    "agency-os",
    "growth-engine",
    "crm",
    "kanban",
    "digital-brands",
    "telegram-bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.20.0",
    "@supabase/supabase-js": "^2.110.8",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "multer": "^2.2.0",
    "node-telegram-bot-api": "^0.66.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "puppeteer": "^25.8.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testTimeout": 15000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests-e2e/"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
