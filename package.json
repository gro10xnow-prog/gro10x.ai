{
  "name": "purplebot-core",
  "version": "0.9.0.0",
  "description": "Purplebot Digital Core Agency OS API & App",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:e2e": "node scripts/e2e/runner.js",
    "db:seed": "node scripts/seed-supabase.js",
    "db:prod-reset": "node scripts/prepare-production-db.js",
    "register-webhook": "node register-webhook.js"
  },
  "keywords": [
    "agency-ops",
    "purplebot",
    "crm",
    "kanban",
    "review-room",
    "telegram-bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "multer": "^2.2.0",
    "node-telegram-bot-api": "^0.66.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "puppeteer": "^25.8.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testTimeout": 15000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests-e2e/"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
