{
  "manifest_version": 3,
  "name": "GRO10X LeadHarvester & AI Profiler",
  "version": "1.0.0",
  "description": "WhatsApp Web group member extraction, AI lead profiling, and 1-click GRO10X CRM sync.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://gro10x-ai.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GRO10X WhatsApp LeadHarvester",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
