# 🟣 PURPLEOS PRODUCTION ENVIRONMENT CONFIGURATION

# Server Port & Mode
PORT=3000
NODE_ENV=production
FORCE_SUPABASE=true

# Supabase Postgres Database & Auth
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Telegram Bots Integration (BotFather Tokens)
TEAM_BOT_TOKEN=your_team_bot_token_here
CLIENT_BOT_TOKEN=your_client_bot_token_here

# Agency Owner Notifications
OWNER_TELEGRAM_ID=your_telegram_user_chat_id_here
