# 🟣 PURPLEOS PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in all values before running locally.
# For Vercel: add each key via Project Settings → Environment Variables.

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production
FORCE_SUPABASE=true

# ─────────────────────────────────────────────
# Supabase Postgres Database & Auth
# ─────────────────────────────────────────────
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─────────────────────────────────────────────
# JWT Signing Secret (REQUIRED in production)
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ─────────────────────────────────────────────
JWT_SECRET=your_64_char_random_hex_secret_here

# ─────────────────────────────────────────────
# Telegram Bots Integration (BotFather Tokens)
# ─────────────────────────────────────────────
TEAM_BOT_TOKEN=your_team_bot_token_here
CLIENT_BOT_TOKEN=your_client_bot_token_here

# Agency Owner Telegram Chat ID (for lead & system notifications)
OWNER_TELEGRAM_ID=your_telegram_user_chat_id_here

# ─────────────────────────────────────────────
# Email (Resend) — Optional but recommended for client onboarding
# Get API key at: https://resend.com/api-keys
# ─────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Purplebot Digital <contact@purplebot.digital>

# ─────────────────────────────────────────────
# Sentry Error Monitoring — Optional
# Get DSN at: https://sentry.io
# ─────────────────────────────────────────────
# SENTRY_DSN=https://your_key@sentry.io/your_project_id

