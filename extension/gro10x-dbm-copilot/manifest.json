{
  "manifest_version": 3,
  "name": "GRO10X DBM Copilot",
  "version": "0.1.1",
  "description": "Batch AI prompting, asset harvesting, and DBM Studio synchronization copilot for GRO10X Digital Brand Managers.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open GRO10X DBM Copilot"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
