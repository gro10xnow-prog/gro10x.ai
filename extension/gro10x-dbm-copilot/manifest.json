{
  "manifest_version": 3,
  "name": "GRO10X DBM Copilot",
  "version": "0.2.0",
  "description": "Batch AI prompting, asset harvesting, relationship WhatsApp outreach, and Social Media Publisher for GRO10X.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://*.facebook.com/*",
    "https://*.youtube.com/*",
    "https://gro10x-ai.vercel.app/*",
    "https://gro10x.ai/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open GRO10X DBM Copilot"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
