{
  "version": 2,
  "name": "purpleos-v06",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/morning-briefing",
      "schedule": "15 3 * * 0,1,2,3,4,6"
    },
    {
      "path": "/api/cron/eod-summary",
      "schedule": "0 14 * * 0,1,2,3,4,6"
    },
    {
      "path": "/api/cron/eod-reminder",
      "schedule": "30 12 * * 0,1,2,3,4,6"
    },
    {
      "path": "/api/cron/daily-briefing",
      "schedule": "0 3 * * 0,1,2,3,4,6"
    },
    {
      "path": "/api/cron/late-clockin-alert",
      "schedule": "0 4 * * 0,1,2,3,4,6"
    },
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/lead-followups",
      "schedule": "30 3 * * 0,1,2,3,4,6"
    },
    {
      "path": "/api/cron/task-overdue",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/approval-expiry",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/invoice-due-reminder",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/payroll-reminder",
      "schedule": "0 3 25 * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 3 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(css|js|images)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/auth(.*)",
      "dest": "/public/auth.html"
    },
    {
      "src": "/pages/(.*)",
      "dest": "/public/pages/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
